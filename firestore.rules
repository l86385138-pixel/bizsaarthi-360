rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owner(id) {
      return signedIn() && request.auth.uid == id;
    }

    match /users/{userId} {
      allow create: if owner(userId);
      allow read, update, delete: if owner(userId);
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create, update, delete: if owner(businessId);
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.businessId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.businessId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid;

      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.businessId == request.auth.uid
        );

      allow update: if signedIn()
        && resource.data.businessId == request.auth.uid;

      allow delete: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.businessId == request.auth.uid
        );
    }

    match /applicationHistory/{historyId} {
      allow read: if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.businessId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.updatedBy == request.auth.uid
        && (
          request.resource.data.customerId == request.auth.uid
          || request.resource.data.businessId == request.auth.uid
        );

      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow read: if signedIn()
        && resource.data.businessId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.businessId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.businessId == request.auth.uid
        && request.resource.data.businessId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.businessId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}